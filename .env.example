# --- Flask ---
SECRET_KEY=change-me-to-32-random-bytes

# --- Volunteer login for the token-minting page ---
VOLUNTEER_USER=volunteer
VOLUNTEER_PASS=change-me

# --- Where this app is reachable (no trailing slash) ---
# Telnyx fetches the fax PDF and posts status here, so it must be the public
# Cloud Run URL, not localhost.
BASE_URL=https://ballot-fax-xxxxxx-uc.a.run.app

# --- Google Cloud Storage ---
GCS_BUCKET=dafax-media

# --- Telnyx ---
TELNYX_API_KEY=KEY...
TELNYX_CONNECTION_ID=
TELNYX_FROM=+1...
# Mission Control -> Account Settings -> Keys & Credentials -> Public Key
TELNYX_PUBLIC_KEY=

# --- Limits (all optional, these are the defaults) ---
TOKEN_TTL_SECONDS=900
MAX_UPLOAD_BYTES=20971520
MAX_PAGES=10
DAILY_PAGE_CAP=200
MEDIA_URL_TTL=900

# --- Optional Cloudflare Turnstile. Left blank, the check is skipped. ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
